name: Windows Cloud PC - AnyDesk

on:
  workflow_dispatch:

jobs:
  build:
    name: Iniciando Windows
    runs-on: windows-latest
    timeout-minutes: 360

    steps:
      - name: Verificar sistema
        shell: powershell
        run: |
          Write-Host "=== WINDOWS CLOUD RUNNER ==="
          Write-Host "Computador: $env:COMPUTERNAME"
          Write-Host "Usuario: $env:USERNAME"

          $os = Get-CimInstance Win32_OperatingSystem
          Write-Host "Windows: $($os.Caption)"

          $cpu = Get-CimInstance Win32_ComputerSystem
          Write-Host "Processadores: $($cpu.NumberOfLogicalProcessors)"
          Write-Host "Memoria: $([math]::Round($cpu.TotalPhysicalMemory / 1GB, 2)) GB"

      - name: Baixar AnyDesk
        shell: powershell
        run: |
          $url = "https://download.anydesk.com/AnyDesk.exe"
          $path = "$env:TEMP\AnyDesk.exe"

          Write-Host "Baixando AnyDesk..."

          Invoke-WebRequest `
            -Uri $url `
            -OutFile $path `
            -UseBasicParsing

          if (-not (Test-Path $path)) {
            Write-Error "Falha ao baixar o AnyDesk."
            exit 1
          }

          Write-Host "AnyDesk baixado com sucesso."

      - name: Iniciar AnyDesk
        shell: powershell
        run: |
          $path = "$env:TEMP\AnyDesk.exe"

          Write-Host "Iniciando AnyDesk..."

          Start-Process `
            -FilePath $path `
            -WindowStyle Normal

          Start-Sleep -Seconds 15

          $process = Get-Process `
            -Name "AnyDesk" `
            -ErrorAction SilentlyContinue

          if ($process) {
            Write-Host "AnyDesk iniciado."
          }
          else {
            Write-Error "AnyDesk nao iniciou."
            exit 1
          }

      - name: Monitorar AnyDesk
        shell: powershell
        run: |
          $path = "$env:TEMP\AnyDesk.exe"

          Write-Host "Monitoramento iniciado."

          while ($true) {
            $process = Get-Process `
              -Name "AnyDesk" `
              -ErrorAction SilentlyContinue

            if (-not $process) {
              Write-Host "AnyDesk foi encerrado."
              Write-Host "Tentando iniciar novamente..."

              if (Test-Path $path) {
                Start-Process `
                  -FilePath $path `
                  -WindowStyle Normal

                Start-Sleep -Seconds 10
              }
            }
            else {
              Write-Host "AnyDesk funcionando - $(Get-Date)"
            }

            Start-Sleep -Seconds 60
          }

      - name: Limpeza
        if: ${{ always() }}
        shell: powershell
        run: |
          Remove-Item `
            "$env:TEMP\AnyDesk.exe" `
            -Force `
            -ErrorAction SilentlyContinue

          Write-Host "Limpeza finalizada."
